# Configuration de l'environnement
NODE_ENV=development

# Port du serveur
PORT=3000

# URL du frontend (pour CORS)
FRONTEND_URL=https://votre-domaine-frontend.com

# Origines CORS supplémentaires (optionnel)
CORS_ORIGIN=https://autre-domaine.com

# Secret JWT
JWT_SECRET=change-me

# Database
# Utilisé en production (Render/Vercel) si défini
DATABASE_URL=
